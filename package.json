{
	"name": "vsquote",
	"displayName": "VSQuote",
	"author": "Rodrigo Ramirez",
	"publisher": "RodrigoRamirez",
	"description": "Unhinged quotes for your coding sessions. Motivational, funny, or chaotic — you choose the vibe.",
	"icon": "images/VsQuoteIcon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/TheRoro/VSQuote.git"
	},
	"homepage": "https://github.com/TheRoro/VSQuote#readme",
	"bugs": {
		"url": "https://github.com/TheRoro/VSQuote/issues"
	},
	"license": "MIT",
	"pricing": "Free",
	"keywords": [
		"quotes",
		"motivation",
		"productivity",
		"status bar",
		"offline",
		"developer",
		"focus",
		"affirmations"
	],
	"version": "3.1.0",
	"engines": {
		"node": ">=20.19",
		"vscode": "^1.120.0"
	},
	"categories": [
		"Other",
		"Education"
	],
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "vsquote.getQuote",
				"title": "Get Quote",
				"category": "VSQuote"
			},
			{
				"command": "vsquote.copyQuote",
				"title": "Copy Current Quote",
				"category": "VSQuote"
			},
			{
				"command": "vsquote.toggleFavorite",
				"title": "Favorite or Unfavorite Current Quote",
				"category": "VSQuote"
			},
			{
				"command": "vsquote.showFavorites",
				"title": "Show Favorites",
				"category": "VSQuote"
			},
			{
				"command": "vsquote.showHistory",
				"title": "Show Quote History",
				"category": "VSQuote"
			},
			{
				"command": "vsquote.chooseMode",
				"title": "Choose Vibe",
				"category": "VSQuote"
			}
		],
		"configuration": {
			"title": "VSQuote",
			"properties": {
				"vsquote.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable or disable VSQuote. When disabled, no quotes will appear."
				},
				"vsquote.interval": {
					"type": "string",
					"default": "60",
					"enum": [
						"30",
						"60",
						"120",
						"360",
						"720",
						"1440"
					],
					"enumItemLabels": [
						"Every 30 minutes",
						"Every 1 hour",
						"Every 2 hours",
						"Every 6 hours",
						"Every 12 hours",
						"Every 24 hours"
					],
					"description": "How often to show an inspirational quote."
				},
				"vsquote.mode": {
					"type": "string",
					"default": "genz",
					"enum": [
						"genz",
						"funny",
						"hype",
						"inspirational",
						"stoic",
						"philosophical",
						"affirmations",
						"all"
					],
					"enumItemLabels": [
						"Gen Z",
						"Funny",
						"Hype",
						"Inspirational",
						"Stoic",
						"Philosophical",
						"Affirmations",
						"All (Random Mix)"
					],
					"description": "The type of quotes to display."
				},
				"vsquote.statusBarMaxLength": {
					"type": "integer",
					"default": 32,
					"minimum": 12,
					"maximum": 80,
					"description": "Maximum number of quote characters shown in the status bar. The full quote remains available in its tooltip and accessible label."
				}
			}
		}
	},
	"scripts": {
		"check-types": "tsc --project jsconfig.json",
		"check-version": "node ./scripts/checkVersion.js",
		"inspect:package": "vsce ls --tree",
		"lint": "eslint .",
		"package": "vsce package --out vsquote.vsix",
		"validate": "npm run lint && npm run check-types && npm run validate:quotes && npm run check-version",
		"validate:quotes": "node ./scripts/validateQuotes.js",
		"vscode:prepublish": "npm run validate",
		"pretest": "npm run validate",
		"test": "node ./test/runTest.js",
		"publish:marketplace": "vsce publish --packagePath vsquote.vsix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.120.0",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"brace-expansion": "^1.1.18",
		"js-yaml": "^4.3.1"
	}
}
