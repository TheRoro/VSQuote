{
	"name": "vsquote",
	"displayName": "VSQuote",
	"author": "Rodrigo Ramirez",
	"publisher": "RodrigoRamirez",
	"description": "Unhinged quotes for your coding sessions. Motivational, funny, or chaotic — you choose the vibe.",
	"icon": "images/VsQuoteIcon.png",
	"repository": "https://github.com/TheRoro/VSQuote",
	"version": "3.0.0",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "vsquote.getQuote",
				"title": "Get Quote"
			}
		],
		"configuration": {
			"title": "VSQuote",
			"properties": {
				"vsquote.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable or disable VSQuote. When disabled, no quotes will appear."
				},
				"vsquote.interval": {
					"type": "string",
					"default": "60",
					"enum": [
						"30",
						"60",
						"120",
						"360",
						"720",
						"1440"
					],
					"enumItemLabels": [
						"Every 30 minutes",
						"Every 1 hour",
						"Every 2 hours",
						"Every 6 hours",
						"Every 12 hours",
						"Every 24 hours"
					],
					"description": "How often to show an inspirational quote."
				},
				"vsquote.mode": {
					"type": "string",
					"default": "genz",
					"enum": [
						"genz",
						"funny",
						"hype",
						"inspirational",
						"stoic",
						"philosophical",
						"affirmations",
						"all"
					],
					"enumItemLabels": [
						"Gen Z",
						"Funny",
						"Hype",
						"Inspirational",
						"Stoic",
						"Philosophical",
						"Affirmations",
						"All (Random Mix)"
					],
					"description": "The type of quotes to display."
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"validate:quotes": "node ./scripts/validateQuotes.js",
		"pretest": "npm run lint && npm run validate:quotes",
		"test": "node ./test/runTest.js"
	},
	"devDependencies": {
		"@types/node": "18.x",
		"@types/vscode": "^1.74.0",
		"eslint": "^8.56.0",
		"@vscode/test-electron": "^2.3.8"
	},
	"overrides": {
		"brace-expansion": "^1.1.18",
		"js-yaml": "^4.3.1"
	}
}